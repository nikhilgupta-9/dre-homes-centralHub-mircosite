# Private files: never served to the browser.
<FilesMatch "^(config|integrity|make-config|sg-apply)\.php$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>
<IfModule mod_autoindex.c>
  Options -Indexes
</IfModule>
